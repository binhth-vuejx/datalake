---
export const prerender = false;
import AdminUsers from "@/components/admin/AdminUsers.svelte";
import ChatOverlay from "@/components/chat-overlay";
import "@/styles/globals.css";
const { workspaceSlug } = Astro.params;
---
<!DOCTYPE html>
<html lang="en" class="h-full antialiased">
<head>
  <meta charset="UTF-8" />
  <title>Admin Users - {workspaceSlug}</title>
  <style>
    body { margin: 0; }
  </style>
</head>
<body class="h-full">
  <AdminUsers client:only="svelte" workspaceSlug={workspaceSlug} />
  <ChatOverlay client:only="react" />
</body>
</html>
